# Copie ce fichier en .env et remplis les valeurs. Ne commite jamais .env.

# Modele
ANTHROPIC_API_KEY=
MUMU_MODEL=claude-sonnet-5-5

# Base de donnees. En local, laisse vide : un fichier SQLite mumu.db est cree.
# En production (Supabase) : postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero du bac a sable Twilio, au format whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Adresse publique du serveur (sans / final), ex. https://mumu.up.railway.app
# Sert a verifier que les requetes viennent bien de Twilio.
PUBLIC_URL=
VALIDATE_TWILIO=true
